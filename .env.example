# ── LLM Backend Selection ─────────────────────────────────────────────
# Options: ollama (default), openai, vllm
# LLM_BACKEND=ollama

# ── Ollama backend (default) ──────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_DEFAULT_MODEL=gemma4:31b

# ── VLLM backend ──────────────────────────────────────────────────────
# Start VLLM: python -m vllm.entrypoints.openai.api_server --model <model> --port 8000
# LLM_BACKEND=vllm
# VLLM_BASE_URL=http://your-gpu-server:8000/v1
# VLLM_API_KEY=EMPTY
# LLM_DEFAULT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# EMBEDDING_BATCH_SIZE=256
# EMBEDDING_MAX_CHARS=3600

# ── OpenAI backend ────────────────────────────────────────────────────
# LLM_BACKEND=openai
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# ── Optional tuning ───────────────────────────────────────────────────
# LLM_TIMEOUT=300
# LLM_MAX_RETRIES=8
# LLM_RETRY_BACKOFF=3.0
# LLM_RETRY_BACKOFF_CAP=60.0
# LLM_HEALTHCHECK_TIMEOUT=300
# RETRIEVAL_MODE=hybrid

# ── Pipeline optimization (added) ─────────────────────────────────────
# Parallel segment extraction worker counts (vLLM handles concurrency natively)
# ENTITY_EXTRACT_WORKERS=8
# RELATION_EXTRACT_WORKERS=8
# Skip multi-agent deliberation for high-confidence items (saves ~30% LLM calls)
# DELIBERATION_CONFIDENCE_THRESHOLD=0.7
# Stricter verification: drops hallucinated relations
# STRICT_VERIFICATION=0
# VERIFICATION_COOCCURRENCE_WINDOW=300
# Persistent vector index cache directory (skips re-embedding on rerun)
# VECTOR_CACHE_DIR=governed_kg_export.vectors
